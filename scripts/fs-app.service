[Unit]
Description=FS App
After=network-online.target
Wants=network-online.target

[Service]
User=fsie
WorkingDirectory=/home/fsie/fs-app
Environment="PATH=/home/fsie/.nvm/versions/node/v26.12.0/bin:/usr/local/bin:/usr/bin:/bin"

ExecStartPre=-/usr/bin/git fetch
ExecStartPre=-/usr/bin/git reset --hard origin/main
ExecStartPre=-/usr/bin/git clean -fd
ExecStartPre=/home/fsie/.nvm/versions/node/v26.12.0/bin/npm i
ExecStartPre=/home/fsie/.nvm/versions/node/v26.12.0/bin/npm run build

ExecStart=/home/fsie/.nvm/versions/node/v26.12.0/bin/npm start
Restart=on-failure
RestartSec=5
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target